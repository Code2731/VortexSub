{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echosub.local/schemas/worker-protocol-v1.schema.json",
  "title": "EchoSub worker NDJSON message v1",
  "oneOf": [
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "sessionStartParams": {
      "type": "object", "required": ["config", "history_policy"],
      "properties": {
        "history_policy": {"const": "retain"},
        "config": {
          "type": "object", "required": ["source_language"],
          "properties": {
            "source_language": {"enum": ["en", "ja", "ko"]},
            "device_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048}
          }, "additionalProperties": false
        }
      }
    },
    "sessionIdentityParams": {
      "type": "object", "required": ["session_id"],
      "properties": {"session_id": {"type": "string", "format": "uuid"}}
    },
    "sessionState": {
      "type": "object",
      "required": ["session_id", "internal_session_id", "epoch", "state", "elapsed_s", "audio_origin_s", "history_policy", "implementation"],
      "properties": {
        "session_id": {"type": ["string", "null"], "format": "uuid"},
        "internal_session_id": {"type": ["integer", "null"], "minimum": 1},
        "epoch": {"type": "integer", "minimum": 0},
        "state": {"enum": ["Idle", "Preparing", "Running", "Paused", "Stopping", "Error"]},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "elapsed_s": {"type": "number", "minimum": 0},
        "audio_origin_s": {"type": "number", "minimum": 0},
        "history_policy": {"const": "retain"},
        "implementation": {"enum": ["uuid-control-adapter", "mock-session-control"]}
      }, "additionalProperties": false
    },
    "fixtureSegmented": {
      "type": "object",
      "required": ["fixture_id", "epoch", "segments", "vad_calls", "vad_s", "audio_duration_s", "vad"],
      "properties": {
        "fixture_id": {"type": "integer", "minimum": 1},
        "epoch": {"type": "integer", "minimum": 1},
        "vad": {"const": true},
        "vad_calls": {"type": "integer", "minimum": 0, "maximum": 250},
        "vad_s": {"type": "number", "minimum": 0},
        "audio_duration_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
        "segments": {
          "type": "array", "maxItems": 250,
          "items": {
            "type": "object",
            "required": ["segment_id", "queued", "audio_start_s", "audio_end_s"],
            "properties": {
              "segment_id": {"type": "integer", "minimum": 1},
              "queued": {"type": "boolean"},
              "audio_start_s": {"type": "number", "minimum": 0},
              "audio_end_s": {"type": "number", "minimum": 0}
            }, "additionalProperties": false
          }
        }
      }, "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "v",
        "kind",
        "request_id",
        "method",
        "params"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "command"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The worker also limits this value to 128 UTF-8 bytes."
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "get_history"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/historyParams"
              }
            }
          }
        },
        {
          "if": {"properties": {"method": {"const": "start_session"}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/sessionStartParams"}}}
        },
        {
          "if": {"properties": {"method": {"enum": ["pause_session", "resume_session", "stop_session"]}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/sessionIdentityParams"}}}
        }
      ]
    },
    "response": {
      "type": "object",
      "required": [
        "v",
        "kind",
        "request_id",
        "ok"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "response"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "result": {
          "type": "object"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "oneOf": [
        {
          "properties": {
            "ok": {
              "const": true
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "properties": {
            "ok": {
              "const": false
            }
          },
          "required": [
            "error"
          ]
        }
      ],
      "additionalProperties": false
    },
    "event": {
      "properties": {
        "kind": {
          "const": "event"
        },
        "v": {
          "const": 1
        },
        "seq": {
          "maximum": 18446744073709551615,
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The client also limits this name to 128 UTF-8 bytes."
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "v",
        "kind",
        "seq",
        "event",
        "payload"
      ],
      "allOf": [{
        "if": {"properties": {"event": {"const": "fixture.segmented"}}},
        "then": {"properties": {"payload": {"$ref": "#/$defs/fixtureSegmented"}}}
      }, {
        "if": {"properties": {"event": {"const": "session.state"}}},
        "then": {"properties": {"payload": {"$ref": "#/$defs/sessionState"}}}
      }],
      "type": "object",
      "additionalProperties": false
    },
    "historyParams": {
      "properties": {
        "limit": {
          "maximum": 4,
          "type": "integer",
          "minimum": 1
        },
        "expected_version": {
          "maximum": 18446744073709551615,
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "maximum": 1000,
          "type": "integer",
          "minimum": 0
        }
      },
      "type": "object",
      "additionalProperties": true
    },
    "historyRecord": {
      "properties": {
        "product_session_id": {"type": "string", "format": "uuid"},
        "session_audio_start_s": {"type": "number", "minimum": 0},
        "session_audio_end_s": {"type": "number", "minimum": 0},
        "segment_id": {
          "maximum": 18446744073709551615,
          "type": "integer",
          "minimum": 0
        },
        "source_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_revision": {
          "maximum": 18446744073709551615,
          "type": "integer",
          "minimum": 0
        },
        "translation": {
          "description": "Also limited to 4096 UTF-8 bytes by worker and client.",
          "type": "string",
          "maxLength": 4096
        },
        "audio_start_s": {
          "minimum": 0,
          "type": "number"
        },
        "audio_end_sample": {
          "maximum": 18446744073709551615,
          "type": "integer",
          "minimum": 0
        },
        "translation_request_id": {
          "maximum": 18446744073709551615,
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "description": "Also limited to 4096 UTF-8 bytes by worker and client.",
          "type": "string",
          "maxLength": 4096
        },
        "session_id": {
          "maximum": 18446744073709551615,
          "type": "integer",
          "minimum": 0
        },
        "translation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_state": {
          "enum": [
            "Partial",
            "FinalPending",
            "Final",
            "Failed",
            "Skipped",
            "Discarded"
          ]
        },
        "audio_end_s": {
          "minimum": 0,
          "type": "number"
        },
        "translation_state": {
          "enum": [
            "None",
            "Pending",
            "Done",
            "Failed",
            "Skipped",
            "Bypassed"
          ]
        },
        "epoch": {
          "maximum": 18446744073709551615,
          "type": "integer",
          "minimum": 0
        },
        "audio_start_sample": {
          "maximum": 18446744073709551615,
          "type": "integer",
          "minimum": 0
        },
        "applied_source_revision": {
          "maximum": 18446744073709551615,
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "segment_id",
        "source_reason",
        "source_revision",
        "translation",
        "audio_start_s",
        "audio_end_sample",
        "translation_request_id",
        "source",
        "session_id",
        "translation_reason",
        "source_state",
        "audio_end_s",
        "translation_state",
        "epoch",
        "audio_start_sample",
        "applied_source_revision"
      ],
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "product_session_id": ["session_audio_start_s", "session_audio_end_s"],
        "session_audio_start_s": ["product_session_id", "session_audio_end_s"],
        "session_audio_end_s": ["product_session_id", "session_audio_start_s"]
      }
    },
    "historyPage": {
      "properties": {
        "last_seq": {
          "minimum": 0,
          "type": "integer"
        },
        "implementation": {
          "enum": ["mock", "native-asr-fixture", "wasapi-capture-diagnostic", "wasapi-live-asr-diagnostic"]
        },
        "next_offset": {
          "maximum": 1000,
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "records": {
          "items": {
            "$ref": "#/$defs/historyRecord"
          },
          "type": "array",
          "maxItems": 4
        },
        "history_version": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "history_version",
        "last_seq",
        "records",
        "next_offset",
        "implementation"
      ],
      "type": "object",
      "additionalProperties": false
    }
  }
}
